{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Down",
  "version": "0.1.0",
  "identifier": "dev.nipunyatawara.ytdown",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "YT Down", "width": 460, "height": 720,
      "minWidth": 400, "minHeight": 540, "visible": false,
      "resizable": false, "decorations": false, "skipTaskbar": true,
      "alwaysOnTop": true, "shadow": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://i.ytimg.com https://i9.ytimg.com data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" } }
}
